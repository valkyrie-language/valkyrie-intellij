<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
	<id>Valkyrie</id>
	<name>Valkyrie Language</name>
	<vendor>voml</vendor>
	<depends>com.intellij.modules.lang</depends>
	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.json</depends>
	<depends>com.intellij.modules.vcs</depends>
	<depends>com.github.voml.voml_intellij</depends>
	<depends optional="true" config-file="integrations/plugin-with-java.xml">com.intellij.java</depends>
	<depends config-file="integrations/plugin-with-toml.xml">org.toml.lang</depends>
	<depends optional="true" config-file="integrations/plugin-with-markdown.xml">org.intellij.plugins.markdown</depends>
	<resource-bundle>messages.ValkyrieBundle</resource-bundle>
	<extensions defaultExtensionNs="com.intellij">
		<xi:include href="languages/valkyrie.xml" parse="xml"/>
	</extensions>
	<xi:include href="actions/valkyrie-actions.xml" parse="xml"/>
</idea-plugin>
