<SYM_MODIFIER>functional</SYM_MODIFIER> <KEYWORD>macro</KEYWORD> <SYM_MACRO>name_of</SYM_MACRO>(<SYM_ARG>ns</SYM_ARG>: <SYM_CLASS>NamepathNode</SYM_CLASS>) {
