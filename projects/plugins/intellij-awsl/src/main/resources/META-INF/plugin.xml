<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
	<id>AWSL</id>
	<name>AWSL Support</name>
	<vendor>voml</vendor>
	<depends>com.intellij.modules.platform</depends>
	<depends optional="true" config-file="integrations/plugin-with-aws.xml">org.jetbrains.plugins.sass</depends>
	<resource-bundle>messages.AwslBundle</resource-bundle>
	<extensions defaultExtensionNs="com.intellij">
		<xi:include href="languages/awsl.xml" parse="xml"/>
	</extensions>
	<xi:include href="actions/awsl-actions.xml" parse="xml"/>
</idea-plugin>
