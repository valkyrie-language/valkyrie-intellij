<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
	<id>com.github.vos_intellij</id>
	<name>VOS Support</name>
	<vendor>voml</vendor>
	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.json</depends>
	<depends optional="true" config-file="integrations/plugin-with-rust.xml">org.rust.lang</depends>
	<resource-bundle>messages.VosBundle</resource-bundle>
	<extensions defaultExtensionNs="com.intellij">
		<xi:include href="languages/vos.xml" parse="xml"/>
	</extensions>
	<xi:include href="actions/vos-actions.xml" parse="xml"/>
</idea-plugin>
