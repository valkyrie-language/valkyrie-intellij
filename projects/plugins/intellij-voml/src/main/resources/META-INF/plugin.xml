<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>com.github.voml.voml_intellij</id>
    <name>VOML Support</name>
    <vendor>voml</vendor>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="integrations/plugin-with-rust.xml">org.rust.lang</depends>
    <resource-bundle>messages.VomlBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <xi:include href="languages/voml.xml" parse="xml"/>
        <xi:include href="languages/von.xml" parse="xml"/>
    </extensions>
    <xi:include href="actions/voml-actions.xml" parse="xml"/>
</idea-plugin>
