<idea-plugin>
    <id>com.github.voml.voml_intellij</id>
    <name>VOML Support</name>
    <vendor>voml</vendor>
    <!-- Product and plugin compatibility requirements -->
    <!-- https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!--    <depends optional="true" config-file="plugin-with-rust.xml">org.rust.lang</depends>-->
    <resource-bundle>messages.VomlBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="VOML"
            implementationClass="voml.surface.file.VomlFileType"
            fieldName="INSTANCE"
            language="VOML"
            extensions="voml"
        />
        <lang.parserDefinition
            language="VOML"
            implementationClass="voml.surface.file.VomlParserDefinition"
        />
        <!-- Highlight -->
        <colorSettingsPage implementation="voml.editing.highlight.VomlColorSettingsPage"/>
        <highlightVisitor implementation="voml.editing.highlight.VomlHighlightVisitor"/>
        <lang.syntaxHighlighter
            language="VOML"
            implementationClass="voml.editing.highlight.VomlSyntaxHighlighter"
        />
        <!-- commenter -->
        <lang.commenter
            language="VOML"
            implementationClass="voml.editing.assist.VomlCommenter"
        />
        <lang.braceMatcher
            language="VOML"
            implementationClass="voml.editing.assist.braces.VomlBraceMatcher"
        />
        <lang.quoteHandler
            language="VOML"
            implementationClass="voml.editing.assist.VomlQuoteHandler"
        />
        <lang.foldingBuilder
            language="VOML"
            implementationClass="voml.editing.folding.VomlFoldingBuilder"
        />
        <indexPatternBuilder
            implementation="voml.editing.todo.VomlTodoIndexPatternBuilder"
        />
        <todoIndexer
            filetype="VOML"
            implementationClass="voml.editing.todo.VomlTodoIndexer"
        />
        <completion.contributor
            language="VOML"
            implementationClass="voml.editing.completion.VomlOptionCompletionContributor"
        />
        <annotator
            language="VOML"
            implementationClass="voml.semantics.inspect.VomlStringEscapingAnnotator"
        />
        <annotator
            language="VOML"
            implementationClass="voml.semantics.inspect.VomlScopeChecker"
        />
        <annotator
            language="VOML"
            implementationClass="voml.semantics.inspect.VomlTableChecker"
        />
        <additionalTextAttributes scheme="Default" file="colors/VomlDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colors/VomlDarcula.xml"/>
        <langCodeStyleSettingsProvider
            implementation="voml.editing.format.codestyle.VomlLanguageCodeStyleSettingsProvider"
        />
        <lang.formatter
            language="VOML"
            implementationClass="voml.editing.format.VomlFormattingModelBuilder"
        />
        <lang.smartEnterProcessor
            language="VOML"
            implementationClass="voml.editing.assist.fixers.VomlSmartEnterProcessor"
        />

        <fileType
            name="VON"
            implementationClass="von.surface.file.VonFileType"
            fieldName="INSTANCE"
            language="VON"
            extensions="von"
        />
        <lang.parserDefinition
            language="VON"
            implementationClass="von.surface.file.VonParserDefinition"
        />
        <colorSettingsPage implementation="von.editing.highlight.VonColorSettingsPage"/>
        <highlightVisitor implementation="von.editing.highlight.VonHighlightVisitor"/>
        <lang.syntaxHighlighter
            language="VON"
            implementationClass="von.editing.highlight.VonSyntaxHighlighter"
        />
        <lang.commenter
            language="VON"
            implementationClass="von.editing.assist.VonCommenter"
        />
        <lang.braceMatcher
            language="VON"
            implementationClass="von.editing.assist.braces.VonBraceMatcher"
        />
        <lang.quoteHandler
            language="VON"
            implementationClass="von.editing.assist.VonQuoteHandler"
        />
        <lang.foldingBuilder
            language="VON"
            implementationClass="von.editing.folding.VonFoldingBuilder"
        />
        <indexPatternBuilder
            implementation="von.editing.todo.VonTodoIndexPatternBuilder"
        />
        <todoIndexer
            filetype="VON"
            implementationClass="von.editing.todo.VonTodoIndexer"
        />
        <completion.contributor
            language="VON"
            implementationClass="von.editing.completion.VonOptionCompletionContributor"
        />
        <annotator
            language="VON"
            implementationClass="von.semantics.inspect.VonStringEscapingAnnotator"
        />
        <annotator
            language="VON"
            implementationClass="von.semantics.inspect.VonScopeChecker"
        />
        <annotator
            language="VON"
            implementationClass="von.semantics.inspect.VonTableChecker"
        />
        <additionalTextAttributes scheme="Default" file="colors/VomlDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colors/VomlDarcula.xml"/>
        <langCodeStyleSettingsProvider
            implementation="von.editing.format.codestyle.VonLanguageCodeStyleSettingsProvider"
        />
        <lang.formatter
            language="VON"
            implementationClass="von.editing.format.VonFormattingModelBuilder"
        />
        <lang.smartEnterProcessor
            language="VON"
            implementationClass="von.editing.assist.fixers.VonSmartEnterProcessor"
        />
    </extensions>
    <actions>
        <action id="voml.editing.actions.VomlCreateFile"
                class="voml.editing.actions.VomlCreateFile"
                text="Voml File"
                description="Create new Voml file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>
        <action id="von.editing.actions.VonCreateFile"
                class="von.editing.actions.VonCreateFile"
                text="Von File"
                description="Create new Von file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="voml.editing.actions.VomlCreateFile"/>
        </action>
    </actions>
</idea-plugin>
