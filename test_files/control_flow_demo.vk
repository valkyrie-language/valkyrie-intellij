// Valkyrie 控制流演示文件
// 用于测试控制流图标和跳转功能

function processData(data: List<String>) -> Result<String, IOException> {
    // Loop 语句示例
    loop i in 0..data.length {
        if data[i].isEmpty() {
            continue  // Continue 语句
        }
        
        if data[i] == "stop" {
            break     // Break 语句
        }
        
        // Raise 语句示例
        if data[i].contains("error") {
            raise IOException("Invalid data: ${data[i]}")
        }
        
        // Yield 语句示例（生成器函数中）
        yield data[i].toUpperCase()
    }
    
    return "Processing completed"  // Return 语句
}

// 异常处理示例
function handleErrors() {
    try {
        let result = processData(["hello", "world", "error"])
        return result
    } catch e: IOException {  // Catch case 示例
        return "IO Error: ${e.message}"
    } catch e: Exception {    // 通用异常处理
        return "General Error: ${e.message}"
    }
}

// 嵌套控制流示例
function complexFlow(items: List<Int>) {
    loop outer in items {
        if outer < 0 {
            continue  // 外层循环的 continue
        }
        
        loop inner in 0..outer {
            if inner == 5 {
                break  // 内层循环的 break
            }
            
            if inner % 2 == 0 {
                yield inner  // 生成偶数
            }
        }
        
        if outer > 100 {
            raise ValidationError("Value too large: ${outer}")
        }
    }
    
    return "Complex flow completed"
}

// 效果处理示例
function fileOperations(filename: String) -> Result<String, FileError> {
    if filename.isEmpty() {
        raise FileNotFoundException("Filename cannot be empty")
    }
    
    if !filename.endsWith(".txt") {
        raise InvalidFormatError("Only .txt files are supported")
    }
    
    try {
        let content = readFile(filename)
        return content
    } catch e: FileNotFoundException {
        return "File not found: ${filename}"
    } catch e: InvalidFormatError {
        return "Invalid format: ${e.message}"
    } catch e: IOException {
        return "IO error: ${e.message}"
    }
}