<idea-plugin>
	<id>Valkyrie</id>
	<name>Valkyrie Language</name>
	<vendor>voml</vendor>
	<depends>com.intellij.modules.lang</depends>
	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.json</depends>
	<depends optional="true" config-file="plugin-with-java.xml">com.intellij.java</depends>
	<depends optional="true" config-file="plugin-with-ultimate.xml">com.intellij.modules.ultimate</depends>
	<depends optional="true" config-file="plugin-with-toml.xml">org.toml.lang</depends>
	<depends optional="true" config-file="plugin-with-markdown.xml">org.intellij.plugins.markdown</depends>
	<resource-bundle>messages.ValkyrieBundle</resource-bundle>
	<extensions defaultExtensionNs="com.intellij">
		<!-- Language -->
		<fileType
			name="valkyrie"
			language="valkyrie"
			extensions="vk;valkyrie;"
			implementationClass="valkyrie.language.file.ValkyrieFileType"
			fieldName="INSTANCE"
		/>

		<!-- Parser Definition -->
		<lang.parserDefinition
			language="valkyrie"
			implementationClass="valkyrie.psi.ValkyrieParserDefinition"
		/>

		<!-- 高亮模块 -->
		<lang.syntaxHighlighter
			language="valkyrie"
			implementationClass="valkyrie.ide.highlight.ValkyrieSyntaxHighlighter"
		/>
		<highlightVisitor
			implementation="valkyrie.ide.highlight.ValkyrieSemanticHighlighter"
		/>
		<colorSettingsPage
			implementation="valkyrie.ide.highlight.ValkyrieColorSettingsPage"
		/>
		<!-- Annotator -->
		<annotator
			language="valkyrie"
			implementationClass="valkyrie.ide.highlight.ValkyrieAnnotator"
		/>

		<!-- Reference Contributor -->
		<psi.referenceContributor
			language="valkyrie"
			implementation="valkyrie.reference.ValkyrieReferenceContributor"
		/>

		<!-- Commenter -->
		<lang.commenter
			language="valkyrie"
			implementationClass="valkyrie.ide.formatter.ValkyrieCommenter"
		/>

		<!-- Find Usages Provider -->
		<lang.findUsagesProvider
			language="valkyrie"
			implementationClass="valkyrie.reference.ValkyrieFindUsagesProvider"
		/>

		<!-- Goto Declaration Handler -->
		<gotoDeclarationHandler implementation="valkyrie.reference.ValkyrieGotoDeclarationHandler"/>

		<!-- Project Manager Service -->
		<projectService
			serviceImplementation="valkyrie.project.ValkyrieProjectManager"
		/>

		<!-- Additional Library Roots Provider -->
		<additionalLibraryRootsProvider
			implementation="valkyrie.project.library.ValkyrieLibraryRootsProvider"
		/>

		<!-- Project View Provider -->
		<treeStructureProvider
			implementation="valkyrie.project.ValkyrieProjectViewProvider"
		/>

		<!-- Startup Activity -->
		<postStartupActivity
			implementation="valkyrie.index.ValkyrieStartupActivity"
		/>

		<!-- Structure View -->
		<lang.psiStructureViewFactory
			language="valkyrie"
			implementationClass="valkyrie.ide.structure.ValkyrieStructureViewProvider"
		/>

		<!-- Formatter -->
		<lang.formatter
			language="valkyrie"
			implementationClass="valkyrie.ide.formatter.ValkyrieFormatBuilder"
		/>
		<codeStyleSettingsProvider
			implementation="valkyrie.ide.formatter.ValkyrieCodeStyleProvider"
		/>

		<!-- Documentation Provider -->
		<lang.documentationProvider
			language="valkyrie"
			implementationClass="valkyrie.ide.documentation.ValkyrieDocumentationProvider"
		/>

		<!-- Breadcrumbs Navigation -->
		<breadcrumbsInfoProvider implementation="valkyrie.ide.navigation.ValkyrieBreadcrumbsProvider"/>

		<!-- Inlay Hints -->
		<codeInsight.inlayProvider
			language="valkyrie"
			implementationClass="valkyrie.ide.hint.ValkyrieInlayHintsProvider"/>
		<codeInsight.inlayProvider
			language="valkyrie"
			implementationClass="valkyrie.ide.hint.type.TypeHintProvider"/>
		<codeInsight.inlayProvider
			language="valkyrie"
			implementationClass="valkyrie.ide.hint.chain.ChainHintProvider"/>

		<!-- Parameter Info -->
		<codeInsight.parameterInfo
			language="valkyrie"
			implementationClass="valkyrie.ide.hint.ValkyrieParameterInfoHandler"/>

		<!-- Control Flow Line Markers -->
		<codeInsight.lineMarkerProvider
			language="valkyrie"
			implementationClass="valkyrie.ide.gutter.ValkyrieControlFlowNavigationProvider"
		/>


		<!-- Test Framework -->
		<configurationType implementation="valkyrie.ide.test.ValkyrieTestConfigurationType"/>
		<runLineMarkerContributor language="valkyrie"
								  implementationClass="valkyrie.ide.test.ValkyrieTestRunLineMarkerProvider"/>
		<codeInsight.lineMarkerProvider language="valkyrie"
										implementationClass="valkyrie.ide.marker.ValkyrieLineMarkerProvider"/>

		<!-- Code Completion -->
		<completion.contributor
			language="valkyrie"
			implementationClass="valkyrie.ide.completion.ValkyrieCompletionContributor"
		/>

		<!-- Refactoring Support -->
		<lang.refactoringSupport
			language="valkyrie"
			implementationClass="valkyrie.ide.refactor.ValkyrieRefactoringProvider"
		/>

		<!-- Rename Handler -->
		<renameHandler implementation="valkyrie.ide.refactor.ValkyrieRenameHandler"/>

		<!-- Rename Input Validator -->
		<renameInputValidator implementation="valkyrie.ide.refactor.ValkyrieRenameInputValidator"/>

		<!-- Code Vision Provider -->
		<codeInsight.codeVisionProviderFactory
			implementation="valkyrie.ide.code_vision.ValkyrieCodeVisionProviderFactory"/>
		<vcs.codeVisionLanguageContext
			language="valkyrie"
			implementationClass="valkyrie.ide.code_vision.ValkyrieAuthorVisionProvider"
		/>
		<codeInsight.daemonBoundCodeVisionProvider
			implementation="valkyrie.ide.code_vision.ValkyrieEffectVisionProvider"
		/>
		<codeInsight.daemonBoundCodeVisionProvider
			implementation="valkyrie.ide.code_vision.ValkyrieInheritorVisionProvider"
		/>
		<codeInsight.daemonBoundCodeVisionProvider
			implementation="valkyrie.ide.code_vision.ValkyrieImplementerVisionProvider"
		/>
		<codeInsight.daemonBoundCodeVisionProvider
			implementation="valkyrie.ide.code_vision.ValkyrieUsageVisionProvider"
		/>
		<config.codeVisionGroupSettingProvider
			implementation="valkyrie.ide.code_vision.ValkyrieEffectVisionSetting"
		/>
		<config.codeVisionGroupSettingProvider
			implementation="valkyrie.ide.code_vision.ValkyrieImplementerVisionSettings"
		/>
		<!-- Intention Actions -->
		<intentionAction>
			<language>valkyrie</language>
			<className>valkyrie.ide.intention.ConvertIfToMatchIntention</className>
			<category>Valkyrie</category>
		</intentionAction>
		<!-- Notification Groups -->
		<notificationGroup id="Valkyrie" displayType="BALLOON" key="notification.group.valkyrie"/>
	</extensions>

	<!-- Actions -->
	<actions>
		<action
			id="valkyrie.ToggleDocumentRenderMode"
			class="valkyrie.ide.documentation.ToggleDocumentRenderModeAction"
			text="Toggle Document Render Mode"
			description="Toggle between rendered and text mode for documentation">
			<add-to-group group-id="ToolbarRunGroup" anchor="after" relative-to-action="RunConfiguration"/>
		</action>
	</actions>
</idea-plugin>
