<idea-plugin>
	<id>Valkyrie</id>
	<name>Valkyrie Language</name>
	<vendor>voml</vendor>
	<depends>com.intellij.modules.lang</depends>
	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.json</depends>
	<depends optional="true" config-file="plugin-with-java.xml">com.intellij.java</depends>
	<depends optional="true" config-file="plugin-with-ultimate.xml">com.intellij.modules.ultimate</depends>
	<depends optional="true" config-file="plugin-with-toml.xml">org.toml.lang</depends>
	<depends optional="true" config-file="plugin-with-markdown.xml">org.intellij.plugins.markdown</depends>
	<resource-bundle>messages.ValkyrieBundle</resource-bundle>
	<extensions defaultExtensionNs="com.intellij">
		<!-- Language -->
		<fileType
			name="valkyrie"
			language="valkyrie"
			extensions="vk;valkyrie;"
			implementationClass="valkyrie.language.file.ValkyrieFileType"
			fieldName="INSTANCE"
		/>
		
		<!-- Parser Definition -->
		<lang.parserDefinition
			language="valkyrie"
			implementationClass="valkyrie.psi.ValkyrieParserDefinition"
		/>
		
		<!-- Syntax Highlighter -->
		<lang.syntaxHighlighterFactory
			language="valkyrie"
			implementationClass="valkyrie.highlighting.ValkyrieSyntaxHighlighterFactory"
		/>
		
		<!-- Color Settings -->
		<colorSettingsPage
			implementation="valkyrie.highlighting.ValkyrieColorSettingsPage"
		/>
		
		<!-- Reference Contributor -->
		<psi.referenceContributor
			implementation="valkyrie.reference.ValkyrieReferenceContributor"
		/>
		
		<!-- Find Usages Provider -->
		<lang.findUsagesProvider
			language="valkyrie"
			implementationClass="valkyrie.reference.ValkyrieFindUsagesProvider"
		/>
		
		<!-- Project Service -->
		<projectService
			serviceImplementation="valkyrie.index.ValkyrieProjectService"
		/>
		
		<!-- Startup Activity -->
		<postStartupActivity
			implementation="valkyrie.index.ValkyrieStartupActivity"
		/>
	</extensions>
</idea-plugin>
