// 测试 tests 语法的高亮效果

// 基本 tests 块
tests basic_math_tests {
    test addition_works() {
        let result = 2 + 3
        assert(result == 5)
    }
    
    test subtraction_works() {
        let result = 10 - 4
        assert(result == 6)
    }
}

// 带修饰符的 tests 块
@integration
tests database_tests {
    test connection_works() {
        let db = Database::connect("test.db")
        assert(db.is_connected())
    }
}

// 独立的 test 函数
@benchmark
test performance_test() {
    benchmark {
        iterations: 1000
        warmup: 100
        
        prepare {
            let data = generate_test_data()
        }
        
        measure {
            process_data(data)
        }
    }
}

// 类中的 tests 块
class Calculator {
    method add(a: Integer, b: Integer) -> Integer {
        return a + b
    }
    
    tests calculator_tests {
        test add_positive_numbers() {
            let calc = Calculator::new()
            let result = calc.add(5, 3)
            assert(result == 8)
        }
        
        test add_negative_numbers() {
            let calc = Calculator::new()
            let result = calc.add(-2, -3)
            assert(result == -5)
        }
    }
}

// 嵌套 tests 块
tests nested_example {
    tests string_operations {
        test concatenation() {
            let result = "hello" + " world"
            assert(result == "hello world")
        }
        
        test length_calculation() {
            let text = "example"
            assert(text.length() == 7)
        }
    }
    
    tests array_operations {
        test array_creation() {
            let arr = [1, 2, 3, 4, 5]
            assert(arr.length() == 5)
        }
    }
}