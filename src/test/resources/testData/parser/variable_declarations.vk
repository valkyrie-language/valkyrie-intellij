// Test file for variable declaration parsing

// Basic variable declarations
let x = 42
let y = "hello"
let z = true
let w = 3.14

// Variable declarations with type annotations
let typed_int: i32 = 42
let typed_string: string = "hello"
let typed_bool: bool = false
let typed_float: f64 = 3.14159

// Mutable variable declarations
let mut mutable_var = 10
let mut mutable_string: string = "changeable"
let mut counter: i32 = 0

// Constant declarations
const CONSTANT_VALUE = 100
const PI: f64 = 3.14159265359
const MAX_SIZE: usize = 1024
const MESSAGE: string = "Hello, World!"

// Variable declarations with complex expressions
let sum = 10 + 20 + 30
let product = 2 * 3 * 4
let complex_expr = (a + b) * (c - d) / e
let boolean_expr = x > 0 && y < 100
let string_concat = "Hello, " + "World!"

// Variable declarations with function calls
let result = calculate(10, 20)
let processed = process_string("input")
let transformed = transform(data, options)

// Variable declarations with array literals
let numbers = [1, 2, 3, 4, 5]
let strings = ["first", "second", "third"]
let mixed_array = [42, "hello", true, 3.14]
let empty_array = []
let nested_array = [[1, 2], [3, 4], [5, 6]]

// Variable declarations with object literals
let person = {
    name: "John",
    age: 30,
    city: "New York"
}

let point = { x: 10, y: 20 }
let empty_object = {}
let nested_object = {
    user: {
        id: 1,
        profile: {
            name: "Alice",
            email: "alice@example.com"
        }
    }
}

// Variable declarations with destructuring
let [first, second, third] = array
let [head, ...tail] = list
let { name, age } = person
let { x, y, z = 0 } = coordinates
let { user: { id, name } } = data

// Variable declarations with pattern matching
let value = match input {
    0 => "zero",
    1 => "one",
    n if n > 1 => "many",
    _ => "negative"
}

let result = match option {
    Some(x) => x * 2,
    None => 0
}

// Variable declarations with conditional expressions
let max = if a > b { a } else { b }
let status = if score >= 90 {
    "excellent"
} else if score >= 70 {
    "good"
} else {
    "needs improvement"
}

// Variable declarations with loops (if they return values)
let squares = for i in 0..10 { i * i }
let filtered = while condition { process_item() }

// Variable declarations with closures/lambdas
let add = |x, y| x + y
let multiply = |a: i32, b: i32| -> i32 { a * b }
let complex_closure = |data| {
    let processed = transform(data)
    validate(processed)
}

// Variable declarations with generic types
let vector: Vec<i32> = Vec::new()
let map: HashMap<string, i32> = HashMap::new()
let optional: Option<string> = Some("value")
let result_type: Result<i32, string> = Ok(42)

// Variable declarations with references (if supported)
let reference = &value
let mutable_ref = &mut variable
let dereferenced = *pointer

// Variable declarations with async expressions (if supported)
let future_result = async { compute_value().await }
let awaited_value = await async_function()

// Variable declarations with try expressions (if supported)
let safe_result = try {
    let x = risky_operation()?
    let y = another_operation(x)?
    x + y
}

// Variable declarations with unsafe blocks (if supported)
let unsafe_value = unsafe {
    *raw_pointer
}

// Variable declarations with macro calls (if supported)
let macro_result = vec![1, 2, 3, 4]
let formatted = format!("Hello, {}!", name)
let debug_info = dbg!(complex_expression)

// Variable declarations with range expressions
let range1 = 0..10
let range2 = 0..=10
let range3 = ..10
let range4 = 0..
let full_range = ..

// Variable declarations with tuple expressions
let tuple = (1, "hello", true)
let nested_tuple = ((1, 2), (3, 4))
let single_element = (42,)  // Note the comma
let empty_tuple = ()

// Variable declarations with struct instantiation
let point = Point { x: 10, y: 20 }
let person = Person {
    name: "Alice".to_string(),
    age: 30,
    ..Default::default()
}

// Variable declarations with enum variants
let color = Color::Red
let option = Option::Some(42)
let result = Result::Ok("success")
let complex_enum = ComplexEnum::Variant {
    field1: "value",
    field2: 123
}

// Variable declarations with method calls
let length = string.len()
let uppercase = text.to_uppercase()
let chained = value.method1().method2().method3()

// Variable declarations with field access
let x_coord = point.x
let user_name = user.profile.name
let nested_field = data.level1.level2.field

// Variable declarations with index access
let first_element = array[0]
let matrix_element = matrix[i][j]
let slice = array[1..5]

// Variable declarations with type casting
let casted = value as i32
let safe_cast = value as? f64
let transmuted = unsafe { transmute::<i32, u32>(value) }

// Variable declarations with string interpolation
let interpolated = "Hello, ${name}! You are ${age} years old."
let complex_interpolation = "Result: ${calculate(a, b)} + ${other_value}"

// Variable declarations with comments
let documented = 42  // This variable holds the answer
let /* inline comment */ weird_comment = "value"

// Multiple variable declarations
let a = 1, b = 2, c = 3
let (x, y) = (10, 20)
let [first, second] = ["hello", "world"]

// Variable declarations with attributes (if supported)
#[derive(Debug)]
let attributed = SomeStruct { field: "value" }

// Variable declarations in different scopes
if condition {
    let scoped_var = "inside if"
    let another = scoped_var + " block"
}

{
    let block_scoped = "in block"
    let calculated = block_scoped.len() * 2
}

for item in collection {
    let loop_var = process(item)
    let transformed = loop_var + 1
}

// Variable declarations with lifetime annotations (if supported)
let lifetime_ref: &'a str = "hello"
let static_ref: &'static str = "static string"

// Variable declarations with where clauses (if supported in let bindings)
let generic_result = create_value::<T>()
where
    T: Clone + Debug

// Error cases for testing error recovery
// let incomplete =  // Missing value
// let = 42  // Missing identifier
// let x: = 42  // Missing type
// let x: i32 =  // Missing value
// let x = 42 42  // Extra token

// End of variable declarations test file