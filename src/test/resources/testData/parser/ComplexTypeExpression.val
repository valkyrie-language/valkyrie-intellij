// 测试复杂类型表达式解析
namespace test {
    // 简单泛型类型
    class SimpleGeneric<T> {}
    
    // 复杂嵌套泛型类型表达式
    class ComplexType {
        field1: C::<D>::<E>
        field2: A::B::<C>::D::<E, F>
        field3: std::collections::HashMap::<String, i32>
        field4: Option::<Result::<T, Error>>
    }
    
    // 函数中使用复杂类型表达式
    function test_complex_types() {
        let x: C::<D>::<E> = create_complex()
        let y: A::B::<C>::D::<E, F> = another_complex()
        let z: std::collections::HashMap::<String, i32> = HashMap::new()
    }
    
    // 继承中使用复杂类型表达式
    class Derived: Base::<T>::Inner::<U> {
        
    }
}