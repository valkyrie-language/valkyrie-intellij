// Test file for expression parsing

// Literal expressions
let integer_literal = 42
let float_literal = 3.14
let string_literal = "hello world"
let char_literal = 'a'
let boolean_true = true
let boolean_false = false
let null_literal = null  // if supported

// Arithmetic expressions
let addition = 10 + 20
let subtraction = 50 - 30
let multiplication = 6 * 7
let division = 100 / 4
let modulo = 17 % 5
let power = 2 ** 8  // if supported
let unary_plus = +42
let unary_minus = -42

// Complex arithmetic expressions
let complex_arithmetic = (10 + 20) * (30 - 15) / 5
let precedence_test = 2 + 3 * 4  // Should be 2 + (3 * 4) = 14
let associativity_test = 100 - 50 - 25  // Should be (100 - 50) - 25 = 25
let mixed_operations = 2 * 3 + 4 * 5 - 6 / 2

// Comparison expressions
let equal = 10 == 10
let not_equal = 10 != 20
let less_than = 5 < 10
let less_equal = 5 <= 10
let greater_than = 15 > 10
let greater_equal = 15 >= 10
let spaceship = a <=> b  // Three-way comparison if supported

// Logical expressions
let logical_and = true && false
let logical_or = true || false
let logical_not = !true
let logical_xor = true ^^ false  // if supported
let complex_logical = (a > 0) && (b < 100) || (c == 0)
let short_circuit = false && expensive_function()  // Should short-circuit

// Bitwise expressions
let bitwise_and = 0xFF & 0x0F
let bitwise_or = 0xF0 | 0x0F
let bitwise_xor = 0xFF ^ 0xAA
let bitwise_not = ~0xFF
let left_shift = 1 << 8
let right_shift = 256 >> 4
let unsigned_right_shift = 256 >>> 4  // if supported

// Assignment expressions
let simple_assign = x = 42
let add_assign = x += 10
let sub_assign = x -= 5
let mul_assign = x *= 2
let div_assign = x /= 3
let mod_assign = x %= 7
let and_assign = x &= 0xFF
let or_assign = x |= 0x0F
let xor_assign = x ^= 0xAA
let shift_left_assign = x <<= 2
let shift_right_assign = x >>= 1

// Increment/decrement expressions (if supported)
let pre_increment = ++counter
let post_increment = counter++
let pre_decrement = --counter
let post_decrement = counter--

// Conditional (ternary) expressions
let ternary = condition ? true_value : false_value
let nested_ternary = a > b ? (c > d ? c : d) : (e > f ? e : f)
let chained_ternary = score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : "F"

// Null coalescing expressions (if supported)
let null_coalesce = nullable_value ?? default_value
let chained_coalesce = first ?? second ?? third ?? "default"
let null_assign = value ??= default_value

// Member access expressions
let dot_access = object.property
let method_call = object.method()
let chained_access = object.property.method().field
let optional_access = object?.property  // Safe navigation if supported
let force_unwrap = optional!  // Force unwrap if supported

// Index access expressions
let array_index = array[0]
let multi_dimensional = matrix[i][j]
let slice_access = array[1..5]
let negative_index = array[-1]  // if supported
let computed_index = array[calculate_index()]

// Function call expressions
let simple_call = function()
let call_with_args = function(arg1, arg2, arg3)
let nested_calls = outer(inner(value))
let chained_calls = object.method1().method2().method3()
let method_call_expr = "hello".to_uppercase().length()

// Range expressions
let inclusive_range = 1..10
let exclusive_range = 1..<10  // or 1..=10 depending on syntax
let unbounded_start = ..10
let unbounded_end = 1..
let full_range = ..
let step_range = 1..10 step 2  // if supported

// Array/list expressions
let simple_array = [1, 2, 3, 4, 5]
let mixed_array = [42, "hello", true, 3.14]
let nested_array = [[1, 2], [3, 4], [5, 6]]
let empty_array = []
let computed_array = [calculate(1), calculate(2), calculate(3)]
let spread_array = [first, ...middle, last]  // if supported

// Object/map expressions
let simple_object = { x: 10, y: 20 }
let complex_object = {
    name: "John",
    age: 30,
    address: {
        street: "123 Main St",
        city: "Anytown"
    },
    hobbies: ["reading", "coding"]
}
let computed_property = { [key]: value }  // if supported
let spread_object = { base, ...additional }  // if supported

// Tuple expressions
let simple_tuple = (1, 2, 3)
let mixed_tuple = (42, "hello", true)
let nested_tuple = ((1, 2), (3, 4))
let single_element_tuple = (42,)  // Note the comma
let empty_tuple = ()

// Lambda/closure expressions
let simple_lambda = |x| x * 2
let typed_lambda = |x: i32, y: i32| -> i32 { x + y }
let complex_lambda = |data| {
    let processed = transform(data)
    validate(processed)
}
let capturing_lambda = |x| x + captured_variable

// Match expressions
let match_expr = match value {
    0 => "zero",
    1 => "one",
    2 | 3 => "two or three",
    n if n > 10 => "large",
    _ => "other"
}

let complex_match = match (x, y) {
    (0, 0) => "origin",
    (0, _) => "on x-axis",
    (_, 0) => "on y-axis",
    (a, b) if a == b => "diagonal",
    _ => "general point"
}

// If expressions
let if_expr = if condition { "true" } else { "false" }
let if_let_expr = if let Some(value) = option { value } else { 0 }
let nested_if = if a > 0 {
    if b > 0 { "both positive" } else { "a positive, b non-positive" }
} else {
    "a non-positive"
}

// Loop expressions (if they can return values)
let loop_result = loop {
    if condition {
        break "result"
    }
}

let while_result = while condition {
    // Process and potentially break with value
}

let for_result = for item in collection {
    if item.matches_criteria() {
        break item.value
    }
}

// Try expressions (if supported)
let try_expr = try {
    let x = risky_operation()?
    let y = another_risky_operation(x)?
    x + y
}

// Async expressions (if supported)
let async_expr = async {
    let result = await some_async_function()
    process(result)
}

let await_expr = await async_function()

// Unsafe expressions (if supported)
let unsafe_expr = unsafe {
    *raw_pointer
}

// Block expressions
let block_expr = {
    let x = 10
    let y = 20
    x + y  // Last expression is the value
}

let complex_block = {
    let data = fetch_data()
    let processed = process(data)
    if processed.is_valid() {
        processed.value
    } else {
        default_value()
    }
}

// Type casting expressions
let cast_expr = value as i32
let safe_cast = value as? f64  // if supported
let transmute_expr = unsafe { transmute::<i32, u32>(value) }  // if supported

// Reference expressions (if supported)
let reference = &value
let mutable_ref = &mut variable
let dereference = *pointer

// Macro call expressions (if supported)
let macro_call = vec![1, 2, 3, 4]
let format_macro = format!("Hello, {}!", name)
let debug_macro = dbg!(complex_expression)

// String interpolation expressions
let interpolated = "Hello, ${name}! You are ${age} years old."
let complex_interpolation = "Result: ${calculate(a, b)} + ${other_function()}"
let nested_interpolation = "Outer ${"Inner ${value}"} string"

// Pipeline expressions (if supported)
let pipeline = value |> transform |> validate |> process
let complex_pipeline = data
    |> filter(predicate)
    |> map(transformer)
    |> reduce(accumulator)

// Composition expressions (if supported)
let composed = func1 >> func2 >> func3
let reverse_composed = func3 << func2 << func1

// Pattern destructuring in expressions
let { x, y } = point
let [first, ...rest] = array
let (a, b, c) = tuple

// Complex nested expressions
let complex_nested = {
    let base = calculate_base()
    let multiplier = if condition {
        complex_calculation(base)
    } else {
        simple_calculation(base)
    }
    
    array.iter()
        .filter(|&x| x > threshold)
        .map(|x| x * multiplier)
        .collect()
}

// Expressions with side effects
let with_side_effects = {
    println!("Computing value...")
    let result = expensive_computation()
    log_result(result)
    result
}

// Recursive expressions
let recursive_expr = if n <= 1 {
    1
} else {
    n * factorial(n - 1)
}

// Expressions with error handling
let error_handled = match risky_operation() {
    Ok(value) => value * 2,
    Err(error) => {
        log_error(error)
        default_value()
    }
}

// Expressions with generics
let generic_expr = create_container::<i32>()
let constrained_generic = process_data::<T>(data) where T: Clone + Debug

// Expressions with lifetimes (if supported)
let lifetime_expr = choose_longer::<'a>(string1, string2)

// Very complex expression combining multiple features
let ultimate_complex = {
    let data = fetch_data().await?
    let processed = data.iter()
        .filter(|item| item.is_valid())
        .map(|item| match item.category {
            Category::A => process_a(item),
            Category::B => process_b(item),
            _ => process_default(item)
        })
        .collect::<Vec<_>>()
    
    if processed.is_empty() {
        Err("No valid items")
    } else {
        let result = processed.iter()
            .fold(0, |acc, item| acc + item.value)
        Ok(result / processed.len())
    }
}

// End of expressions test file