# Match with multiple expressions in case body
match expr {
    case Pattern1: expr1; expr2; expr3
    case Pattern2: 
        let x = compute()
        process(x)
        return x
    else: defaultAction(); cleanup()
}

# Complex match with semicolon-separated expressions
match request {
    case GET(path): 
        log("GET request")
        validatePath(path)
        handleGet(path)
    case POST(data):
        validateData(data)
        processPost(data)
        sendResponse()
    else:
        logError("Unknown request")
        sendError()
}