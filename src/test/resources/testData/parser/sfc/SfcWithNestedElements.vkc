<template>
    <div class="nested-component">
        <header>
            <nav>
                <ul>
                    <li><a href="#home">Home</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
        </header>
        <main>
            <section class="content">
                <article>
                    <h2>Article Title</h2>
                    <p>Article content with <strong>bold</strong> and <em>italic</em> text.</p>
                    <div class="metadata">
                        <span class="author">Author: {{ author }}</span>
                        <span class="date">Date: {{ publishDate }}</span>
                    </div>
                </article>
            </section>
            <aside>
                <div class="sidebar">
                    <h3>Related Links</h3>
                    <ul>
                        <li v-for="link in relatedLinks" :key="link.id">
                            <a :href="link.url">{{ link.title }}</a>
                        </li>
                    </ul>
                </div>
            </aside>
        </main>
        <footer>
            <p>&copy; 2024 Nested Component Example</p>
        </footer>
    </div>
</template>