<template>
    <div class="void-tags-component">
        <h1>Component with Void Tags</h1>
        
        <!-- Self-closing void tags -->
        <img src="image.jpg" alt="Test image" />
        <hr />
        <br />
        <input type="text" placeholder="Enter text" />
        <meta charset="utf-8" />
        <link rel="stylesheet" href="styles.css" />
        
        <!-- More void tags -->
        <area shape="rect" coords="0,0,100,100" href="test.html" />
        <base href="/" />
        <col span="2" />
        <embed src="video.mp4" />
        <source src="audio.mp3" type="audio/mpeg" />
        <track kind="subtitles" src="subtitles.vtt" />
        <wbr />
        
        <p>Text with line break <br /> and word break opportunity<wbr />here.</p>
    </div>
</template>