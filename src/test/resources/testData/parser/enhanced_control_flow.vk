// Enhanced Control Flow Test Data
// 用于测试新实现的控制流语句解析功能

// Basic control flow statements
break;
continue;
raise error;
yield value;

// Control flow with labels
break ※outer;
continue ※inner;
yield ※generator result;

// Control flow in loops
while condition {
    if should_skip {
        continue;
    }
    if should_exit {
        break;
    }
    yield item;
}

// Nested control flow with labels
※outer for i in range {
    ※inner for j in items {
        if error_condition {
            raise CustomError(i, j);
        }
        if skip_condition {
            continue ※inner;
        }
        if exit_condition {
            break ※outer;
        }
        yield ※processor (i, j);
    }
}

// Generator function with control flow
function fibonacci_generator() -> Iterator<i32> {
    let mut a = 0;
    let mut b = 1;
    
    ※main_loop while true {
        if b > 1000 {
            break ※main_loop;
        }
        
        yield b;
        
        let temp = a + b;
        a = b;
        b = temp;
    }
}

// Error handling with raise
function divide(a: f64, b: f64) -> f64 {
    if b == 0.0 {
        raise DivisionByZeroError("Cannot divide by zero");
    }
    return a / b;
}

// Complex control flow example
function process_data(data: Vec<Item>) -> Iterator<ProcessedItem> {
    ※outer_loop for batch in data.chunks(100) {
        ※inner_loop for item in batch {
            // Skip invalid items
            if !item.is_valid() {
                continue ※inner_loop;
            }
            
            // Handle critical errors
            if item.is_critical_error() {
                raise CriticalError(item.error_message());
            }
            
            // Stop processing if limit reached
            if processed_count >= MAX_ITEMS {
                break ※outer_loop;
            }
            
            // Yield processed item
            yield ※processor item.process();
        }
    }
}

// Async generator with control flow
async function async_generator() -> AsyncIterator<Result<Data, Error>> {
    ※retry_loop for attempt in 1..=3 {
        try {
            let data = await fetch_data();
            yield Ok(data);
        } catch error {
            if attempt == 3 {
                raise FinalError(error);
            }
            continue ※retry_loop;
        }
    }
}