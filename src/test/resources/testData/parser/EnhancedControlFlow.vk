// Enhanced control flow test
if condition {
    do_something()
} else if other_condition {
    do_other()
} else {
    do_default()
}

// While loop
while x > 0 {
    x = x - 1
}

// For loop
for i in 0..10 {
    println(i)
}

// Match expression
match value {
    1 => "one",
    2 => "two",
    _ => "other"
}