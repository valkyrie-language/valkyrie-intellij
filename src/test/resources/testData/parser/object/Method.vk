class {
    # 简单微方法声明
    myMethod1() {}
    # 带有参数的微方法
    myMethod2(param1: Type1, param2: Type2) {}
    # 带有返回类型的微方法
    myMethod3(): ReturnType {}
    # 带有参数和返回类型的微方法
    myMethod4(param: Type): ReturnType {}
    # 带有单个属性的微方法
    ↯attribute myMethod5() {}
    # 带有多个属性的微方法
    ↯[attribute2, attribute3] myMethod6() {}
    modifier myMethod7() {}
}