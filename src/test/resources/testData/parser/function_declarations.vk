// Functions with complex parameter patterns
fn destructure_tuple((x, y): (i32, i32)) -> i32 {
    x + y
}

fn destructure_struct(Point { x, y }: Point) -> f64 {
    (x * x + y * y).sqrt()
}

fn pattern_match_param(option: Option<i32>) -> i32 {
    match option {
        Some(value) => value,
        None => 0
    }
}

// Higher-order functions
fn higher_order(f: fn(i32) -> i32, x: i32) -> i32 {
    f(x)
}

fn closure_param<F>(f: F, x: i32) -> i32 
where 
    F: Fn(i32) -> i32 {
    f(x)
}

fn return_function() -> fn(i32) -> i32 {
    |x| x * x
}

// Recursive functions
fn factorial(n: i32) -> i32 {
    if n <= 1 {
        1
    } else {
        n * factorial(n - 1)
    }
}

fn fibonacci(n: i32) -> i32 {
    match n {
        0 => 0,
        1 => 1,
        _ => fibonacci(n - 1) + fibonacci(n - 2)
    }
}

// Mutually recursive functions
fn is_even(n: i32) -> bool {
    if n == 0 {
        true
    } else {
        is_odd(n - 1)
    }
}

fn is_odd(n: i32) -> bool {
    if n == 0 {
        false
    } else {
        is_even(n - 1)
    }
}

// Functions with complex bodies
fn complex_function(data: Vec<i32>) -> Result<f64, string> {
    if data.is_empty() {
        return Err("Empty data".to_string())
    }
    
    let mut sum = 0
    let mut count = 0
    
    for value in data {
        if value > 0 {
            sum += value
            count += 1
        }
    }
    
    if count == 0 {
        Err("No positive values".to_string())
    } else {
        Ok(sum as f64 / count as f64)
    }
}

// Function with nested functions (if supported)
fn outer_function(x: i32) -> i32 {
    fn inner_function(y: i32) -> i32 {
        y * 2
    }
    
    let result = inner_function(x)
    result + 1
}

// Function with closures
fn function_with_closures() {
    let add = |x, y| x + y
    let multiply = |a: i32, b: i32| -> i32 { a * b }
    
    let complex_closure = |data: Vec<i32>| {
        data.iter()
            .filter(|&&x| x > 0)
            .map(|&x| x * 2)
            .collect::<Vec<i32>>()
    }
    
    let result = add(5, 3)
    let product = multiply(4, 6)
}

// Method definitions (if supported)
impl MyStruct {
    fn new(value: i32) -> Self {
        Self { field: value }
    }
    
    fn method(&self) -> i32 {
        self.field
    }
    
    fn mutable_method(&mut self, new_value: i32) {
        self.field = new_value
    }
    
    fn consuming_method(self) -> i32 {
        self.field
    }
    
    fn static_method() -> string {
        "static".to_string()
    }
}

