// 测试高亮效果的示例文件

// Class 声明 - class 名称应该是类颜色
public class TestClass {
    // Field 声明 - modifier 应该是关键字颜色
    private field: String
    
    // Method 声明 - modifier 应该是关键字颜色
    public method test_method() -> String {
        return "test"
    }
    
    // Domain 声明 - domain name 应该是 meta 颜色
    protected domain TestDomain: String
}

// Trait 声明 - trait 名称应该是接口颜色
trait TestTrait {
    method trait_method() -> String
}

// Union 声明
union TestUnion {
    variant VariantA {
        field: String
    }
    
    variant VariantB {
        value: Integer
    }
}

// 更多 modifier 测试
static class StaticClass {
    readonly field readonly_field: String
    async method async_method() -> String
    virtual method virtual_method() -> String
}