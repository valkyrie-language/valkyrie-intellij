// 测试语义高亮功能
// 这个文件用于验证 ValkyrieSemanticHighlighter 是否正确工作

// 修饰符测试
public class TestClass {
    private field: String
    
    public static method staticMethod() {
        // 静态方法
    }
    
    public method instanceMethod(self) {
        // 实例方法
    }
}

// 特征测试
public trait TestTrait {
    method traitMethod()
}

// 联合类型测试
union TestUnion {
    variant VariantA
    variant VariantB(value: Integer)
}

// 域测试
domain TestDomain {
    field domainField: String
}

// 嵌套结构测试
namespace test {
    private class NestedClass {
        protected field nestedField: Boolean
        
        public method nestedMethod(self, param: String) {
            // 嵌套类的方法
        }
    }
}