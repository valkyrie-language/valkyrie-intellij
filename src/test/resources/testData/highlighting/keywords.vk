// Test file for keyword highlighting

// Control flow keywords
if condition {
    // if block
} else if other_condition {
    // else if block
} else {
    // else block
}

while counter < limit {
    counter += 1
    if counter > 100 {
        break
    }
    if counter % 2 == 0 {
        continue
    }
}

for item in collection {
    process(item)
}

for i in 0..10 {
    println!("Index: {}", i)
}

loop {
    if should_exit {
        break
    }
}

match value {
    0 => "zero",
    1 => "one",
    _ => "other"
}

// Variable and constant declarations
let variable = 42
let mut mutable_var = "changeable"
const CONSTANT = 100
static STATIC_VAR = "static"

// Function keywords
fn function_name() {
    return 42
}

async fn async_function() {
    await some_operation()
}

unsafe fn unsafe_function() {
    // unsafe operations
}

extern "C" fn c_function() {
    // C-compatible function
}

// Type keywords
struct Point {
    x: f64,
    y: f64,
}

enum Color {
    Red,
    Green,
    Blue,
}

union Data {
    integer: i32,
    float: f32,
}

trait Drawable {
    fn draw(&self)
}

type Alias = Vec<String>

// Implementation keywords
impl Point {
    fn new(x: f64, y: f64) -> Self {
        Self { x, y }
    }
}

impl Drawable for Point {
    fn draw(&self) {
        println!("Drawing point at ({}, {})", self.x, self.y)
    }
}

// Module keywords
mod my_module {
    pub fn public_function() {}
    
    pub(crate) fn crate_public() {}
    
    pub(super) fn super_public() {}
    
    fn private_function() {}
}

use std::collections::HashMap
use crate::my_module::public_function

// Visibility keywords
pub struct PublicStruct {
    pub field: i32,
    private_field: String,
}

// Memory management keywords (if applicable)
let reference = &value
let mutable_ref = &mut variable
let owned = Box::new(42)
let raw_ptr = ptr as *const i32

// Error handling keywords
fn fallible_function() -> Result<i32, String> {
    if condition {
        Ok(42)
    } else {
        Err("Something went wrong".to_string())
    }
}

// Generic keywords
fn generic_function<T>(value: T) -> T 
where T: Clone {
    value.clone()
}

struct GenericStruct<T, U> {
    first: T,
    second: U,
}

// Lifetime keywords (if supported)
fn lifetime_function<'a>(x: &'a str) -> &'a str {
    x
}

struct LifetimeStruct<'a> {
    data: &'a str,
}

// Boolean literals
let true_value = true
let false_value = false

// Null/None keywords (if supported)
let optional = Some(42)
let empty = None
let null_value = null  // if supported

// Self keywords
impl MyStruct {
    fn new() -> Self {
        Self { field: 0 }
    }
    
    fn method(self) -> Self {
        self
    }
}

// Super keyword (if supported)
impl Child {
    fn method(&self) {
        super::parent_method()
    }
}

// Macro keywords
macro_rules! my_macro {
    ($x:expr) => {
        println!("Value: {}", $x)
    }
}

// Attribute keywords
#[derive(Debug, Clone)]
struct AttributedStruct {
    field: i32,
}

#[cfg(target_os = "windows")]
fn windows_only() {}

#[inline]
fn inlined_function() {}

#[test]
fn test_function() {
    assert_eq!(2 + 2, 4)
}

// Import/export keywords
export fn exported_function() {}  // if supported
import { function } from "module"  // if supported

// Async/await keywords
async fn async_example() {
    let result = await fetch_data()
    process(result)
}

// Try/catch keywords (if supported)
try {
    risky_operation()
} catch error {
    handle_error(error)
} finally {
    cleanup()
}

// Yield keyword (if supported for generators)
fn* generator() {
    yield 1
    yield 2
    yield 3
}

// Class keywords (if supported)
class MyClass {
    constructor(value) {
        this.value = value
    }
    
    method() {
        return this.value
    }
}

// Interface keywords (if supported)
interface MyInterface {
    method(): void
}

// Abstract keywords (if supported)
abstract class AbstractClass {
    abstract method(): void
}

// Final keywords (if supported)
final class FinalClass {}

// Override keywords (if supported)
class Child extends Parent {
    override method() {
        super.method()
    }
}

// Virtual keywords (if supported)
virtual fn virtual_method() {}

// Operator keywords (if supported)
operator + (left: MyType, right: MyType) -> MyType {
    // Addition implementation
}

// Package/namespace keywords (if supported)
package com.example.mypackage

namespace MyNamespace {
    fn function() {}
}

// Delegate keywords (if supported)
delegate fn MyDelegate(x: i32) -> i32

// Event keywords (if supported)
event MyEvent(data: String)

// Property keywords (if supported)
property Name: String {
    get { return self.name }
    set(value) { self.name = value }
}

// Contextual keywords that might be highlighted differently
where T: Clone + Debug  // where is contextual
move |x| x + 1  // move is contextual
dyn Trait  // dyn is contextual
impl Trait for Type  // impl, for are contextual

// Keywords in different contexts
if let Some(value) = option {
    // if let pattern
}

while let Some(item) = iterator.next() {
    // while let pattern
}

match result {
    Ok(value) => value,
    Err(error) => panic!("Error: {}", error),
}

// Keywords with operators
let result = value is Type  // type checking
let casted = value as NewType  // type casting
let size = sizeof(Type)  // size operator
let align = alignof(Type)  // alignment operator

// End of keywords test file