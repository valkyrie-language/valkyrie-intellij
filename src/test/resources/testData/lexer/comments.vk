// Nested comments (if supported)
/* Outer comment /* inner comment */ still outer */
/* Another /* nested /* deeply nested */ comment */ example */

// Documentation comments
/// This is a documentation comment for the following item
/// It can span multiple lines
/// and typically uses triple slashes

/** 
 * JavaDoc style documentation comment
 * @param parameter Description of parameter
 * @return Description of return value
 */

//! Module level documentation comment
//! This documents the entire module or crate

/*!
 * Block style module documentation
 * with multiple lines
 */

// Comments in different positions
let variable = 42; // End of line comment
let another = /* inline comment */ 123;
let complex = 1 + /* comment */ 2 * /* another */ 3;

// Comments before code elements
// Function documentation
fn example_function() {
    // Comment inside function
    let x = 10; // Variable comment
    
    /* Block comment
       inside function */
    return x;
}

// Class/struct documentation
/// Represents a point in 2D space
struct Point {
    /// X coordinate
    x: f64,
    /// Y coordinate  
    y: f64, // Inline comment
}

