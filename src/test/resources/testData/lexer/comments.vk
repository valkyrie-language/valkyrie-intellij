// Very long comments
// This is a very long comment that spans across what would normally be multiple lines if it were wrapped, containing lots of text to test how the lexer handles longer comment content with various words, punctuation marks, numbers like 12345, symbols like !@#$%, and other characters that might appear in real-world comments including references to code elements, URLs, and detailed explanations of complex algorithms or business logic.

/*
 * Very long multi-line comment that contains extensive documentation
 * about a complex system or algorithm, including detailed explanations,
 * code examples, mathematical formulas, references to external resources,
 * and comprehensive usage instructions that developers might need to
 * understand the implementation details and proper usage patterns.
 */

// Comments with different languages
// English comment
// Comentario en español
// Commentaire en français
// Kommentar auf Deutsch
// コメント in Japanese
// 中文注释
// Комментарий на русском
// تعليق باللغة العربية

// Comments at different indentation levels
if condition {
    // Indented comment level 1
    if nested_condition {
        // Indented comment level 2
        let value = 42; // End of line at level 2
        
        /* Multi-line comment
         * at indentation level 2
         */
    }
}

