// Test file for keyword lexing

// Basic keywords
let mut x = 42
fn hello() {}
if true { return false }
else { break }
for i in range { continue }
while condition { }

// Type keywords
let a: i32 = 0
let b: f64 = 3.14
let c: string = "hello"
let d: bool = null

// Control flow
match value {
    Some(x) => x,
    None => 0
}

// Memory management
let ptr = &variable
let owned = move value

// Visibility
pub fn public_function() {}
priv fn private_function() {}

// Async/await (if supported)
async fn async_function() {
    await some_future
}

// Traits and implementations
trait Display {
    fn display(self) -> string
}

impl Display for MyType {
    fn display(self) -> string {
        "MyType"
    }
}

// Modules
mod my_module {
    use super::Display
    
    pub struct InnerType;
}

// Constants and statics
const MAX_SIZE: usize = 1024
static GLOBAL_VAR: i32 = 42

// Unsafe code (if supported)
unsafe {
    let raw_ptr = ptr as *const i32
}

// Macros (if supported)
macro_rules! my_macro {
    () => { println!("Hello, macro!") }
}

// Attributes
#[derive(Debug, Clone)]
struct AttributedStruct {
    field: i32
}

// Generics
fn generic_function<T>(param: T) -> T {
    param
}

struct GenericStruct<T, U> {
    first: T,
    second: U
}

// Lifetimes (if supported)
fn lifetime_function<'a>(param: &'a str) -> &'a str {
    param
}

// Self keyword
impl MyStruct {
    fn method(self) -> Self {
        Self { ..self }
    }
    
    fn associated_function() -> Self {
        Self::default()
    }
}

// Where clauses
fn where_function<T>(param: T) -> T 
where 
    T: Clone + Debug 
{
    param.clone()
}

// Dyn keyword (if supported)
let trait_object: Box<dyn Display> = Box::new(my_instance)

// Extern (if supported)
extern "C" {
    fn external_function(param: i32) -> i32
}

extern crate external_crate

// Union (if supported)
union MyUnion {
    int_value: i32,
    float_value: f32
}

// Type aliases
type MyAlias = Vec<String>
type Result<T> = std::result::Result<T, Error>

// Associated types
trait Iterator {
    type Item
    
    fn next(&mut self) -> Option<Self::Item>
}

// Higher-ranked trait bounds (if supported)
fn higher_ranked<F>(f: F) 
where 
    F: for<'a> Fn(&'a str) -> &'a str 
{
    // Implementation
}

// Raw identifiers (if supported)
let r#type = "type is a keyword"
let r#match = "match is a keyword"

// Keywords in different contexts
let let_var = let_function()
fn fn_name() { fn_call() }
if if_condition { if_block() }

// End of keyword test file