// 测试所有三种泛型语法的解析

// Class 声明的泛型语法测试
class A⟨T⟩ {
    field: T
}

class B<T> {
    field: T
}

class C::<T> {
    field: T
}

// Trait 声明的泛型语法测试
trait Display⟨T⟩ {
    micro fmt(self) -> String
}

trait Clone<T> {
    micro clone(self) -> Self
}

trait Debug::<T> {
    micro debug_fmt(self) -> String
}

// Union 声明的泛型语法测试
union Option⟨T⟩ {
    Some { value: T }
    None
}

union Result<T, E> {
    Ok { value: T }
    Err { error: E }
}

union Either::<L, R> {
    Left { value: L }
    Right { value: R }
}

// Micro 函数声明的泛型语法测试
micro identity⟨T⟩(value: T) -> T {
    value
}

micro compare<T>(a: T, b: T) -> bool {
    a == b
}

micro transform::<T, U>(value: T, f: T -> U) -> U {
    f(value)
}

// 多个泛型参数测试
class Map⟨K, V⟩ {
    entries: [(K, V)]
}

trait Convert<From, To> {
    micro convert(from: From) -> To
}

union Triple::<A, B, C> {
    Value { a: A, b: B, c: C }
}

micro zip<A, B, C>(a: A, b: B, c: C) -> (A, B, C) {
    (a, b, c)
}

// 测试尾随逗号支持
class TrailingCommaTest⟨T, U,⟩ {
    field: T
}

trait TrailingCommaTrait<A, B,> {
    micro test(self) -> String
}

union TrailingCommaUnion::<X, Y,> {
    First { value: X }
    Second { value: Y }
}

micro trailing_comma_func<T, U,>(a: T, b: U,) -> (T, U) {
    (a, b)
}

// 测试表达式中的泛型调用语法
micro test_generic_calls() {
    // 合法的泛型调用形式
    let result1 = call⟨String⟩("hello")
    let result2 = call::<i32>(42)
    let result3 = func⟨T, U⟩(a, b)
    let result4 = transform::<String, i32>("123", parse)
    
    // 特殊名称标识符测试
    let `special name` = 100
    let `another special` = "test"
    let `function with spaces` = 42
    let normal_id = `special name` + 50
    
    // 泛型调用与特殊名称结合
    let result5 = `special function`⟨T⟩()
    let result6 = `another func`::<String>("param")
    let result7 = `generic method`⟨i32, String⟩(123, "abc")
    
    // 嵌套泛型调用
    let result8 = outer⟨T⟩(inner::<U>(value))
    let result9 = `complex call`⟨A⟩(`nested func`::<B>(param))
}