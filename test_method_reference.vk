namespace test

class Iterator {
    method next(self) -> String {
        return "next_value"
    }
    
    method hasNext(self) -> Boolean {
        return true
    }
}

class TestClass {
    method test2(self) -> Integer {
        return 42
    }
    
    method getValue(self) -> String {
        return "test_value"
    }
}

micro main() {
    let items = Iterator()
    let result = items.next()  // 这里应该能跳转到 Iterator.next 方法
    
    let second = TestClass()
    let value = second.test2()  // 这里应该能跳转到 TestClass.test2 方法
    let str = second.getValue()  // 这里应该能跳转到 TestClass.getValue 方法
    
    // 测试链式调用
    let iterator = Iterator()
    if iterator.hasNext() {
        let data = iterator.next()
    }
}