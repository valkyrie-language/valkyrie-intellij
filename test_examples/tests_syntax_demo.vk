// Tests 语法演示文件
// 用于验证 tests 关键词和相关语法的解析功能

// 1. 简单的 tests 块
tests {
    test function simple_test() {
        assert(1 + 1 == 2)
    }
    
    test function another_test() {
        let result = calculate_something()
        assert(result > 0)
    }
}

// 2. 带注解和修饰符的 tests 块
@benchmark
public tests {
    benchmark(data) {
        performOperation(data)
    }
    
    prepare {
        setupTestData()
    }
    
    before {
        initializeState()
    }
    
    after {
        cleanupState()
    }
    
    clean {
        releaseResources()
    }
    
    config {
        timeout = 5000
        iterations = 100
    }
}

// 3. 独立的 test 函数
test function standalone_test() {
    let value = getValue()
    assert(value != null)
}

@slow
test function slow_test() {
    performLongRunningOperation()
    assert(true)
}

// 4. 类中的 tests 块
class Calculator {
    function add(a: Int, b: Int) -> Int {
        return a + b
    }
    
    tests {
        test function test_add() {
            let calc = Calculator()
            let result = calc.add(2, 3)
            assert(result == 5)
        }
        
        test function test_add_negative() {
            let calc = Calculator()
            let result = calc.add(-1, 1)
            assert(result == 0)
        }
    }
    
    // 类中的独立 test 函数
    test function test_constructor() {
        let calc = Calculator()
        assert(calc != null)
    }
}

// 5. 嵌套的 tests 块
tests {
    tests {
        test function nested_test() {
            assert(true)
        }
        
        tests {
            test function deeply_nested_test() {
                assert(1 == 1)
            }
        }
    }
    
    benchmark(performance_data) {
        processData(performance_data)
    }
}

// 6. 复杂的 benchmark DSL
tests {
    prepare {
        database.connect()
        cache.clear()
    }
    
    before {
        transaction.begin()
    }
    
    benchmark(user_data) {
        let user = createUser(user_data)
        let result = userService.save(user)
        assert(result.isSuccess())
    }
    
    after {
        transaction.rollback()
    }
    
    clean {
        database.disconnect()
    }
    
    config {
        warmup_iterations = 10
        measurement_iterations = 100
        timeout = 30000
        memory_limit = "1GB"
    }
}